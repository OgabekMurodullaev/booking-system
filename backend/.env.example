# Copy this file to .env and adjust as needed. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://booking:booking@db:5432/booking
TEST_DATABASE_URL=postgres://booking:booking@db:5432/booking

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Business rules (CLAUDE.md §6) — defaults shown, override only if needed
BOOKING_SLOT_STEP_MINUTES=15
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_MAX_ADVANCE_DAYS=30
BOOKING_HOLD_TTL_MINUTES=10
AVAILABILITY_MAX_QUERY_DAYS=14
