# Copy to deploy/.env on the server. Read directly by docker-compose.prod.yml for ${VAR}
# interpolation (DOMAIN in the Caddy service, Postgres creds in the db service). Django's own
# settings still come from backend/.env (see backend/.env.example) — this file is compose-level
# only. Never commit the real deploy/.env.

# Production domain, e.g. booking.example.com or <server-ip>.sslip.io if no domain is
# registered yet. For local `docker compose -f deploy/docker-compose.prod.yml up --build`
# testing without a real domain, set DOMAIN=:80 so Caddy serves plain HTTP on port 80 with no
# ACME/TLS attempt at all (matches the section's own local acceptance criterion, which is
# http://localhost, not https).
DOMAIN=example.com

# Leave unset for real Let's Encrypt certificates. Set to Let's Encrypt's *staging* directory
# while testing a fresh deploy, to avoid hitting LE's production rate limits before things are
# confirmed working end to end:
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=

POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me-to-a-random-password

# Only needed if ports 80/443 are already taken on this host by another site (e.g. a
# shared VPS running other projects behind their own nginx). Leave unset for a dedicated
# server. When set, also set DOMAIN above to an explicit "http://..." address so Caddy
# doesn't attempt to get a TLS certificate on a non-standard port.
# CADDY_HTTP_PORT=8080
# CADDY_HTTPS_PORT=8443
