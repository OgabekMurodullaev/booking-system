# Copy this file to .env.local and adjust as needed. Never commit the real .env.local.

# Base URL for the backend API. Leave unset to use the Vite dev proxy (/api -> localhost:8000).
VITE_API_BASE_URL=

# Demo login buttons on the Login page. Each pair is optional; a button only renders
# when both its email and password are set. Matches the accounts created by
# `python manage.py seed_demo` (backend/apps/common/management/commands/seed_demo.py).
VITE_DEMO_CUSTOMER_EMAIL=demo.customer@bookingsystem.test
VITE_DEMO_CUSTOMER_PASSWORD=DemoPass123!
VITE_DEMO_PROVIDER_EMAIL=demo.provider@bookingsystem.test
VITE_DEMO_PROVIDER_PASSWORD=DemoPass123!
VITE_DEMO_ADMIN_EMAIL=demo.admin@bookingsystem.test
VITE_DEMO_ADMIN_PASSWORD=DemoPass123!
