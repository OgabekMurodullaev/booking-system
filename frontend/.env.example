# Copy this file to .env.local and adjust as needed. Never commit the real .env.local.

# Base URL for the backend API. Leave unset to use the Vite dev proxy (/api -> localhost:8000).
VITE_API_BASE_URL=

# Demo login buttons on the Login page. Each pair is optional; a button only renders
# when both its email and password are set.
VITE_DEMO_CUSTOMER_EMAIL=
VITE_DEMO_CUSTOMER_PASSWORD=
VITE_DEMO_PROVIDER_EMAIL=
VITE_DEMO_PROVIDER_PASSWORD=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
